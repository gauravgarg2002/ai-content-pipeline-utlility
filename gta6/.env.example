# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=            # Google AI Studio, free tier
YOUTUBE_API_KEY=           # optional: YouTube Data API key for topic search (free quota)
TELEGRAM_BOT_TOKEN=        # same bot as the other pipelines (BotFather)
TELEGRAM_CHAT_ID=          # your chat id; only messages from it are accepted
# YouTube OAuth: put each channel's client_secret.json in .secrets/<hi|en>/ (one Google account per channel)
